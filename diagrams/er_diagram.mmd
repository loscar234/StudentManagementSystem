    PERSONS {
        int id PK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar phone
        enum gender
        date date_of_birth
        varchar address
        timestamp created_at
        timestamp updated_at
    }

    STUDENTS {
        int id PK
        int person_id FK
        varchar reg_number UK
        varchar programme
        int year_of_study
        int semester
        date enrollment_date
        enum status
    }

    LECTURERS {
        int id PK
        int person_id FK
        varchar staff_id UK
        varchar department
        varchar qualification
        varchar specialization
        date hire_date
        enum status
    }

    COURSES {
        int id PK
        varchar course_code UK
        varchar title
        text description
        int credit_hours
        varchar department
        int level
        int semester
        timestamp created_at
    }

    STUDENT_COURSES {
        int id PK
        int student_id FK
        int course_id FK
        varchar academic_year
        int semester
