    }

    LECTURER_COURSES {
        int id PK
        int lecturer_id FK
        int course_id FK
        varchar academic_year
        int semester
        date assigned_date
    }

    SCORES {
        int id PK
        int student_id FK
        int course_id FK
        varchar academic_year
        int semester
        decimal cat_score
        decimal exam_score
        decimal total_score
        varchar grade
        varchar remarks
        int entered_by FK
        timestamp entered_at
        timestamp updated_at
    }

    BOOKS {
        int id PK
        varchar isbn UK
        varchar title
        varchar author
        varchar edition
        varchar version
        year year_published
        varchar publisher
        varchar category
        int total_copies
        int available_copies
        varchar shelf_location
        timestamp created_at
    }

    BORROWING_RECORDS {
        int id PK
        int student_id FK
        int book_id FK
        date borrow_date
        date due_date
        date return_date
        enum status
        decimal fine_amount
        varchar notes
    }

    RESERVATIONS {
        int id PK
        int student_id FK
        int book_id FK
        date reservation_date
        date expiry_date
        enum status
    }

